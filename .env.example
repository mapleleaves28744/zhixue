# App
APP_NAME=zhixue-workshop
APP_ENV=development
DEBUG=true
SQL_ECHO=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
HTTP_PORT=80
OPENMAIC_PORT=3001

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / pgvector
POSTGRES_USER=zhixue
POSTGRES_PASSWORD=zhixue_password
POSTGRES_DB=zhixue
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://zhixue:zhixue_password@localhost:5432/zhixue

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# OpenMAIC repository-contained immersive classroom engine
OPENMAIC_ENABLED=false
OPENMAIC_BASE_URL=http://127.0.0.1:3001
OPENMAIC_PUBLIC_BASE_URL=http://127.0.0.1:3001
OPENMAIC_INTERNAL_TOKEN=replace-with-a-long-random-service-token
OPENMAIC_SIGNING_SECRET=replace-with-a-different-long-random-signing-secret
OPENMAIC_REQUEST_TIMEOUT_SECONDS=30
OPENMAIC_JOB_MAX_WAIT_SECONDS=1800
OPENMAIC_PLAYBACK_TOKEN_TTL_SECONDS=600
# 单个课堂场景的内容或动作生成超过此时间后跳过，避免整堂课永久卡住
OPENMAIC_SCENE_STEP_TIMEOUT_MS=180000
# 沉浸课堂场景与 TTS 使用保守受控并发；提高会更快，但需确认模型服务配额
OPENMAIC_CLASSROOM_SCENE_CONCURRENCY=2
OPENMAIC_CLASSROOM_TTS_CONCURRENCY=2
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
XIAOMI_MODELS=mimo-v2.5
DEFAULT_MODEL=xiaomi:mimo-v2.5
TTS_XIAOMI_MIMO_API_KEY=
TTS_XIAOMI_MIMO_BASE_URL=
ASR_XIAOMI_MIMO_API_KEY=
ASR_XIAOMI_MIMO_BASE_URL=

# JWT
JWT_SECRET=change_me_in_local_env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-learning-model
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# LangGraph Agent Runtime
AGENT_MAX_ITERATIONS=15
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_REPLANS=5
AGENT_WORKER_CONCURRENCY=4
# 本地开发：Worker 未启动时，3 秒后由 API 进程内联执行（避免任务一直排队）
AGENT_INLINE_FALLBACK=true
AGENT_INLINE_FALLBACK_DELAY_SECONDS=3

# Embedding Provider
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSION=1024

# File Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,ppt,pptx,txt,md

# Wiki
WIKI_DEFAULT_COURSE_NAME=数据结构
WIKI_REQUIRE_SOURCE=true
WIKI_ENABLE_VERSIONING=true

# Evolution
EVOLUTION_ENABLE_AUTO_APPLY_LOW_RISK=true
EVOLUTION_REQUIRE_CONFIRM_MEDIUM_RISK=true
EVOLUTION_REQUIRE_ADMIN_HIGH_RISK=true
EVOLUTION_DEFAULT_RISK_LEVEL=low

# Multimodal (Agnes Sapiens — https://agnes-ai.com/doc)
# mock = 无文生图 API，插图请求自动 Mermaid 知识卡片兜底
MULTIMODAL_PROVIDER=mock
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
